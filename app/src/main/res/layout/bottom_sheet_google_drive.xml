<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_workspace_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="16dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="#3B4254" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_workspace_drive"
            app:tint="#38BDF8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drive_title"
                android:textColor="#F0F6FC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/drive_account_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/drive_not_connected"
                android:textColor="#8B949E"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_drive_up"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/workspace_menu_up_desc"
            android:src="@drawable/ic_workspace_up"
            app:tint="#C9D1D9" />

        <ImageButton
            android:id="@+id/btn_drive_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/workspace_menu_refresh_desc"
            android:src="@drawable/ic_workspace_refresh"
            app:tint="#C9D1D9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_drive_connect"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="48dp"
            android:text="@string/drive_connect_btn"
            android:textAllCaps="false"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:strokeColor="#2F4A65" />
    </LinearLayout>

    <!-- Local target + Drive path indicator -->
    <TextView
        android:id="@+id/drive_path_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_workspace_input"
        android:ellipsize="start"
        android:fontFamily="monospace"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:singleLine="true"
        android:textColor="#38BDF8"
        android:textSize="12sp" />

    <!-- Action Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_drive_backup_zip"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:minHeight="48dp"
                android:text="@string/drive_backup_folder_zip"
                android:textAllCaps="false"
                android:textColor="#06150E"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#10B981"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_workspace_archive"
                app:iconSize="16dp"
                app:iconTint="#06150E" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_drive_upload_local"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:minHeight="48dp"
                android:text="@string/drive_upload_files_folders"
                android:textAllCaps="false"
                android:textColor="#081018"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#38BDF8"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_workspace_upload"
                app:iconSize="16dp"
                app:iconTint="#081018" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_drive_new_folder"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="48dp"
                android:text="@string/drive_new_folder"
                android:textAllCaps="false"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeColor="#4A3918" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Search Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_workspace_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_workspace_search"
            app:tint="#6E7681" />

        <EditText
            android:id="@+id/drive_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/drive_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#E6EDF3"
            android:textColorHint="#6E7681"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Progress / Status -->
    <LinearLayout
        android:id="@+id/drive_progress_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="#38BDF8" />

        <TextView
            android:id="@+id/drive_progress_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#C9D1D9"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Drive File List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:layout_marginTop="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drive_file_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/drive_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_workspace_drive"
                app:tint="#4B5563" />

            <TextView
                android:id="@+id/drive_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/drive_empty_prompt"
                android:textColor="#8B949E"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Batch Actions on Drive -->
    <LinearLayout
        android:id="@+id/drive_batch_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_drive_batch_clear"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:text="@string/editor_cancel"
            android:textAllCaps="false"
            android:textColor="#C9D1D9"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:strokeColor="#30363D" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_drive_batch_delete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/drive_delete_selected"
            android:textAllCaps="false"
            android:textColor="#F87171"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_workspace_delete"
            app:iconSize="16dp"
            app:iconTint="#F87171"
            app:strokeColor="#5A2222" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_drive_batch_download"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/drive_download_selected"
            android:textAllCaps="false"
            android:textColor="#081018"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#38BDF8"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_workspace_download"
            app:iconSize="16dp"
            app:iconTint="#081018" />
    </LinearLayout>

</LinearLayout>
