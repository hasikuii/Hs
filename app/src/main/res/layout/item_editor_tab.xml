<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tab_container"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_editor_tab_inactive"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="4dp">

    <View
        android:id="@+id/tab_dirty_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_dirty_dot"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tab_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxWidth="150dp"
        android:singleLine="true"
        android:textColor="#E6EDF3"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/tab_close_btn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/editor_close_tab_desc"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_workspace_close"
        app:tint="#8B949E" />

</LinearLayout>
