<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later OR Apache-2.0
  Layout for WirelessAdbActivity: pair / connect / shell console.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADB không dây (kiểu Shizuku)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kết nối tới adbd trên chính thiết bị này qua TLS 1.3, chạy shell với UID 2000 (shell). Yêu cầu Android 11+ và Wireless debugging."
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="+id/adb_sdk_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#3b1d1d"
            android:padding="10dp"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thiết bị dưới Android 11 không hỗ trợ ghép nối không dây. Tính năng này bị tắt."
                android:textColor="#ff8a80"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="+id/adb_fingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Khóa ADB: đang sinh…"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:paddingBottom="6dp" />

        <TextView
            android:id="+id/adb_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa kết nối."
            android:textSize="13sp"
            android:textStyle="italic"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Ghép nối (Pairing)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mở Cài đặt → Tùy chọn nhà phát triển → Gỡ lỗi không dây → Ghép thiết bị bằng mã ghép nối. Nhập cổng + mã 6 số bên dưới (chỉ cần 1 lần)."
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp">
            <EditText
                android:id="+id/adb_pair_port"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Cổng ghép nối"
                android:inputType="number" />
            <EditText
                android:id="+id/adb_pair_code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:hint="Mã 6 số"
                android:inputType="number" />
        </LinearLayout>

        <Button
            android:id="+id/adb_pair_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghép nối" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Kết nối"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nhập cổng từ màn hình chính của Gỡ lỗi không dây (động, đổi khi bật/tắt)."
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp">
            <EditText
                android:id="+id/adb_connect_port"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Cổng kết nối"
                android:inputType="number" />
            <Button
                android:id="+id/adb_connect_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kết nối" />
            <Button
                android:id="+id/adb_disconnect_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngắt"
                android:enabled="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Shell (UID shell)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp">
            <Button
                android:id="+id/adb_quick_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="id -u"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
            <Button
                android:id="+id/adb_quick_packages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="pm list -3"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
            <Button
                android:id="+id/adb_quick_logcat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="logcat"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>

        <EditText
            android:id="+id/adb_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lệnh shell, vd: dumpsys activity top | head -50"
            android:inputType="text"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:imeOptions="actionDone" />

        <Button
            android:id="+id/adb_run_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chạy"
            android:enabled="false" />

        <TextView
            android:id="+id/adb_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:background="#1a1a1a"
            android:textColor="#e0e0e0"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
